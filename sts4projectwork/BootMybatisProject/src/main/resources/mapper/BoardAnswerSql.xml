<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="boot.data.mapper.BoardAnswerMapperInter">
 	<insert id="insertAnswer" parameterType="mbanswer">
 		insert into mbanswer values(null,#{num},#{name},#{myid},#{content},now())
 	</insert>
 	
 	<select id="getAllAnswers" parameterType="String" resultType="mbanswer">
 		select * from mbanswer where num=#{num} order by idx
 	</select>
 	
 	<select id="getAnswer" parameterType="String" resultType="mbanswer">
 		select * from mbanswer where idx=#{idx}
 	</select>
 	
 	<update id="updateAnswer" parameterType="mbanswer">
 		update mbanswer set cotent=#{content} where idx=#{idx}
 	</update>
 	
 	<delete id="deleteAnswer" parameterType="String">
 		delete from mbanswer where idx=#{idx}
 	</delete>
</mapper>